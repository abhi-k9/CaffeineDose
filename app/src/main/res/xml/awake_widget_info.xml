<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget, see AwakeWidget.kt: 1×1 by default, resizable, updated by the app only (no periodic update). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_info_description"
    android:initialLayout="@layout/widget_stacked"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/widget_preview_image"
    android:previewLayout="@layout/widget_stacked"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
