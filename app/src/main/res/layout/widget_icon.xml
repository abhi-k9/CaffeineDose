<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget, smallest size: the icon alone. Off by default, AwakeWidget applies the current state. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_off"
    android:contentDescription="@string/widget_description_off">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_tile"
        android:tint="@color/widget_off_content" />
</FrameLayout>
